\topic{presentation}

\summary{Beamer theme for the Salzburg University of Applied Sciences}

\begin{description}
  beamertheme-fhs is a theme for the LaTeX beamer class following the
  corporate design of the Salzburg University of Applied Sciences
  (Fachhochschule Salzburg, FH Salzburg).

  It provides a title page with the FH Salzburg logos, a frame title with
  logo, a footline with date, institute, author and frame number, standout
  frames for highlighted statements, and optional auto-generated
  Creative Commons license   notices (CC BY 4.0, CC BY-SA 4.0) on
  the title page in English or German.
\end{description}

\begin{announcement}
  beamertheme-fhs provides a beamer theme following the corporate design
  of the Salzburg University of Applied Sciences (FH Salzburg), including
  optional Creative Commons license notices on the title page.
\end{announcement}

